generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

model Customer {
  id                String   @id @default(cuid())
  fullName          String
  mobileNumber      String   @unique
  email             String   @unique
  
  // Address details
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  pincode           String
  
  planDuration      Int      // 12 or 24
  houseType         String   // "permanent" or "rent"
  
  // Document references (S3 URLs, file paths, etc.)
  aadharFrontImageUrl String?
  aadharBackImageUrl  String?
  panFrontImageUrl    String?
  panBackImageUrl     String?
  residenceDocUrl   String?  // EB Bill or Rental Agreement
  
  // Payment info
  paymentStatus     String   @default("PENDING") // PENDING, COMPLETED, FAILED
  razorpayOrderId   String?
  razorpayPaymentId String?

  // Rental Subscription info
  rentalPlanDuration Int?     // 12 or 24
  rentalAmount       Int?     // 699 or 449
  subscriptionStatus String   @default("INACTIVE") // INACTIVE, ACTIVE, CANCELLED
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  lastPaymentDate    DateTime?
  billingDay         Int?      // day-of-month billing anchor (from subscriptionStart), used to compute every renewal so drift doesn't accumulate month over month

  // Rental autopay (UPI Autopay / e-mandate via Razorpay Subscriptions).
  // Once ACTIVE, Razorpay itself drives the billing cycle for this customer —
  // see processRenewals, which skips anyone with a razorpaySubscriptionId.
  razorpaySubscriptionId String? @unique
  razorpayPlanId         String?
  // NOT_SET: never had autopay. CANCELLED: had it, explicitly turned off
  // (e.g. via a return) — independent of subscriptionStatus, which may go
  // back to ACTIVE later while autopay stays CANCELLED until re-activated.
  autopayStatus          String?  @default("NOT_SET") // NOT_SET, PENDING, ACTIVE, FAILED, CANCELLED

  // Proof (screenshot/receipt) that a plan-downgrade deposit refund was
  // actually sent to the customer. Required before the admin can confirm a
  // downgrade in "Change Plan"; cleared once the plan change is applied.
  planChangeRefundProofUrl String?

  // Assigned product details, set manually by admin (not collected from customer)
  modelName          String?
  machineSerialNumber String?

  // Product return info (separate from subscription cancellation)
  returnRequested    Boolean   @default(false)
  returnRequestedAt  DateTime?
  refundAmount       Int?      // Final refund decided by admin after inspecting the returned product

  // Bank details the customer provides at return-request time, so the admin
  // has where to send the refund once refundAmount is fixed.
  refundBankAccountHolderName String?
  refundBankName               String?
  refundBankIfscCode           String?
  refundBankAccountNumber      String?

  // General-purpose bank account details the customer can submit any time
  // (via bankDetailsForm), independent of a return/refund — e.g. so the
  // admin has somewhere to send an ad-hoc manual payout.
  bankAccountHolderName String?
  bankName              String?
  bankIfscCode          String?
  bankAccountNumber     String?

  invoices          Invoice[]
  returnProcessEvents ReturnProcessEvent[]
  paymentLinks      PaymentLinkRequest[]
  payouts           CustomerPayout[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// One row per billed/refunded transaction, so each gets its own permanent
// bill number and a re-downloadable PDF receipt (Customer only tracks the
// latest payment, not history).
model Invoice {
  id            String   @id @default(cuid())
  billNumber    String   @unique
  type          String   // SECURITY_DEPOSIT, RENTAL, REFUND
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  productType   String   // display label, e.g. "Refundable Security Deposit"
  amount        Int      // INR
  paymentMethod String   // "Razorpay" or "Manual"
  transactionId String?  // razorpayPaymentId, null for manual refunds
  status        String   // FUNDED, REFUNDED
  reason        String?  // shown as "No reason available." when null

  documentDate  DateTime @default(now())
  createdAt     DateTime @default(now())
}

// One row per admin update to a return-process step — an append-only log
// (never edited or overwritten), so the full history of a customer's return
// is auditable. The "current" status of a step is simply its most recent
// event by createdAt.
model ReturnProcessEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  step       String   // DEINITIALIZATION_INITIATED, DEFECT_REPORTED, MACHINE_COLLECTED, MACHINE_RECEIVED_WAREHOUSE, REFUND_INITIATED, PAYMENT_REFUNDED
  status     String   // PENDING/COMPLETED for most steps, YES/NO for DEFECT_REPORTED
  eventDate  DateTime // business date the admin attributes this update to
  remarks    String?  // required when step=DEFECT_REPORTED and status=YES
  defectImageUrls String[] // up to 3 photos, only used when step=DEFECT_REPORTED and status=YES

  createdAt  DateTime @default(now()) // when this log entry was actually recorded
}

// One row per ad-hoc Razorpay payment link an admin generates for a customer
// (e.g. to collect a fixed amount like ₹499), so the amounts requested over
// time stay visible even after the link itself expires.
model PaymentLinkRequest {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  amount        Int      // INR
  razorpayPaymentLinkId String? @unique // e.g. "plink_xxx", used to match incoming webhook events back to this row; nullable only for rows created before this field existed
  shortUrl      String
  expireBy      DateTime

  status            String    @default("CREATED") // CREATED, PAID, EXPIRED, CANCELLED — flipped to PAID by the Razorpay webhook
  razorpayPaymentId String?
  paidAt            DateTime?

  // Set only for links generated from the "Change Plan" panel as a deposit
  // top-up. Once this link is paid (webhook or manual "Mark as Paid"), the
  // plan change is applied automatically — see applyPlanChange in
  // planChange.service.ts — instead of requiring a separate manual
  // "Confirm & Apply Plan Change" click.
  planChangeTargetDuration Int?

  createdAt     DateTime @default(now())
}

// A manual, immediate payment the company makes TO a customer (e.g. a
// goodwill refund or ad-hoc adjustment unrelated to a specific deposit/plan
// event) — recorded directly by the admin, no Razorpay involved, so it's
// always "Completed" the moment it's saved. Paired with PaymentLinkRequest
// (the Customer -> Admin direction) to form the customer's unified
// "Transaction History" of ad-hoc money movement.
model CustomerPayout {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])

  amount      Int      // INR
  reason      String
  // Screenshot/receipt proving the payment was actually sent. Nullable at
  // the DB level only because payouts recorded before this field existed
  // have none — createPayout still requires it for every new payout.
  proofUrl    String?

  createdAt   DateTime @default(now())
}

// Atomic per-type-per-year sequence used to generate bill numbers like
// SEC-2026-00001. id is "{prefix}-{year}", e.g. "SEC-2026".
model BillCounter {
  id      String @id
  lastSeq Int    @default(0)
}

// Captures the registration all the way through "form submitted, awaiting
// payment" — a person only becomes a Customer once their payment succeeds
// (see verifyPayment). Until then, everything they entered — including
// uploaded documents, once the form itself has been submitted — lives here,
// so a cancelled/failed/abandoned payment leaves a followable Draft instead
// of a half-registered Customer.
model CustomerDraft {
  id                String   @id
  fullName          String?
  mobileNumber      String?  @unique
  email             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?
  planDuration      Int?
  houseType         String?
  residenceDocType  String?

  aadharFrontImageUrl String?
  aadharBackImageUrl  String?
  panFrontImageUrl    String?
  panBackImageUrl     String?
  residenceDocUrl     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
